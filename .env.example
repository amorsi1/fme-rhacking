# ── GCP ─────────────────────────────────────────────────────────────────────
GCP_PROJECT=your-gcp-project-id
GCP_ZONE=us-central1-a
GCP_INSTANCE=fme-rhacking-train

# Machine type with 2× L4 GPUs (24 GB each) — fits 3B FFT and 7B LoRA.
# For 7B FFT use a2-highgpu-2g (2× A100 40 GB).
GCP_MACHINE_TYPE=g2-standard-24
GCP_DISK_SIZE=300GB

# GCS bucket for checkpoint archival (created by infra/provision.sh).
GCP_BUCKET=fme-rhacking-data

# Remote repo path on the VM. gcloud ssh logs in as your local $USER.
GCP_REMOTE_DIR=/home/YOUR_USERNAME/fme-rhacking

# ── Weights & Biases ─────────────────────────────────────────────────────────
WANDB_API_KEY=your_wandb_api_key
# Optional; defaults to your personal workspace if unset.
WANDB_ENTITY=your_wandb_entity

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Only needed for distillation data generation (datagen/openai_inference.py).
OPENAI_API_KEY=sk-...
