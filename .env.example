# ── GCP ─────────────────────────────────────────────────────────────────────
GCP_PROJECT=your-gcp-project-id ## REQUIRED
GCP_ZONE=us-central1-a
GCP_INSTANCE=fme-rhacking-train

# Machine type; it fixes the GPU count (G2 types attach L4s automatically).
# g2-standard-8 = 1× L4 (24 GB); g2-standard-24 = 2× L4; a2-highgpu-2g = 2× A100 40 GB.
# Keep trainer.n_gpus_per_node in the launch config equal to the GPU count.
GCP_MACHINE_TYPE=g2-standard-8
GCP_DISK_SIZE=300GB

# GCS bucket for checkpoint archival (created by infra/provision.sh).
GCP_BUCKET=fme-rhacking-data

# Remote repo path on the VM. gcloud ssh logs in as your local $USER.
GCP_REMOTE_DIR=/home/${USER}/fme-rhacking

# ── Weights & Biases ─────────────────────────────────────────────────────────
WANDB_API_KEY=your_wandb_api_key ## REQUIRED
# Optional; defaults to your personal workspace if unset.
WANDB_BASE_URL=https://forge.coreweave.com
WANDB_ENTITY=fme-team
# Shared project so the whole team's runs land together.
WANDB_PROJECT=fme-rhacking


